import turtle as t
import random

screen = t.Screen()
screen.tracer(0) #turns off the animation, so that the tree can be drawn faster. We will call t.update() at the end to update the screen with the final drawing
t.ht() # hides the turtle
t.speed(0)
t.setheading(270)#faces south
t.penup()
t.forward(250)
t.setheading(90)
t.pendown() #makes the turtle go a bit lower, so that there is more space.

#global variables
a=0
s=0
baselength=0

def randomfractaltree(level, length):
    
    global a,s, baselength

    if level == 0: #base case. if the level is 0, then we stop drawing
        return  #returns to the previous level of the tree

    t.forward(length) #draws the trunk of the tree

    rand_angle = random.randint(int(a-10), int(a+10)) #random angle for the branches of the tree, so that the tree looks more natural
    rand_scale = random.uniform(s-0.1, s+0.1) #random scale for the branches of the tree, so that the tree looks more natural
    
    t.left(rand_angle)
    randomfractaltree(level - 1, length * rand_scale) #recursive call to draw the left branch of the tree if the level is 3, then it will draw a level two tree (level-1)
    
    t.right(2*rand_angle)
    randomfractaltree(level - 1, length * rand_scale) #same as before, but this one is for the riht subtree.

    #reset
    t.left(rand_angle)
    t.backward(length) 

print("## USER INTERFACE ##")
i = int(input("Enter the level of the tree: "))
baselength = int(input("Enter the length of the trunk: "))
a = int(input("Enter the angle between branches: "))
s = float(input("Enter the scale (e.g. 0.75): "))

randomfractaltree(i, baselength)
t.update() 
t.done()